# Enforce Linux line endings (LF) for all text files
* text=auto eol=lf

# Explicitly mark code files as text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.scss text
*.md text
*.mdx text

# Ensure shell scripts always use LF (critical for Linux/Docker environments)
*.sh text eol=lf

# Denote binary files (Git will leave these untouched)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.svg text
*.webp filter=lfs diff=lfs merge=lfs -text